# Backend server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
# Comma-separated list of allowed origins for the React frontend
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
# Use the connection string format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example (from project_management_db/db_connection.txt, without the leading `psql `):
# DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=
